<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeid="format3"?>
<package format="3">
  <name>yolov8_bdd100k_detection</name>
  <version>0.0.1</version>
  <description>YOLOv8 BDD100K detection package for Isaac ROS with SLAM integration</description>
  <maintainer email="sophie@example.com">sophie</maintainer>
  <license>Apache License 2.0</license>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  
  <!-- Isaac ROS dependencies -->
  <depend>isaac_ros_tensor_rt</depend>
  <depend>isaac_ros_nitros</depend>
  <depend>isaac_ros_visual_slam</depend>
  <depend>isaac_ros_common</depend>
  
  <!-- Navigation dependencies -->
  <depend>nav2_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
