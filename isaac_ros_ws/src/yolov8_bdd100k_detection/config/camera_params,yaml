yolov8_camera_node:
  ros__parameters:
    # Model configuration
    model_path: "/home/sophie/visionaid/models/yolov8/best.onnx"
    confidence_threshold: 0.5
    inference_rate: 30.0
    
    # Camera configuration
    camera_width: 640
    camera_height: 480
    camera_fps: 30
    enable_depth: true
    
    # Publishing options
    publish_detection_images: true
    publish_raw_images: true
    
    # Performance tuning
    max_detections: 50
    nms_threshold: 0.4
