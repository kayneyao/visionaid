<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeid="format3"?>
<package format="3">
  <name>yolov8_detection</name>
  <version>0.0.1</version>
  <description>Taiwan 17-Class YOLOv8 Detection Package for Multimodal Traffic Safety System</description>
  <maintainer email="sophiehsuu@gmail.com">sophie</maintainer>
  <license>Apache License 2.0</license>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS 2 dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  
  <!-- Computer Vision dependencies -->
  <depend>image_transport</depend>
  <depend>image_geometry</depend>
  <depend>compressed_image_transport</depend>
  
  <!-- RealSense camera dependencies -->
  <depend>realsense2_camera</depend>
  <depend>realsense2_camera_msgs</depend>
  
  <!-- Isaac ROS dependencies -->
  <depend>isaac_ros_tensor_rt</depend>
  <depend>isaac_ros_nitros</depend>
  <depend>isaac_ros_visual_slam</depend>
  <depend>isaac_ros_common</depend>
  <depend>isaac_ros_detectnet</depend>
  
  <!-- RTAB-Map SLAM dependencies -->
  <depend>rtabmap_msgs</depend>
  <depend>rtabmap_conversions</depend>
  
  <!-- Navigation dependencies -->
  <depend>nav2_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  
  <!-- Python package dependencies -->
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>python3-torch</depend>
  <depend>python3-torchvision</depend>
  
  <!-- ONNX Runtime dependencies -->
  <depend>python3-onnx</depend>
  <depend>python3-onnxruntime</depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
